+		CPU_TURBO : in std_logic_vector(1 downto 0) := "00";
 
 		ROM_RD		: out std_logic;
 		ROM_RDY		: in  std_logic;
@@ -269,6 +270,7 @@ port map(
 	CLK 		=> CLK,
 	RST_N		=> RESET_N,
 	WAIT_N	=> ROM_RDY and not CPU_PAUSE_EN,
+	CPU_TURBO => CPU_TURBO,
 
 	IRQ1_N	=> VDC0_IRQ_N and VDC1_IRQ_N,
 	IRQ2_N	=> CD_IRQ_N,
